$body = @{
    Prompt = "a cat wearing sunglasses"
    NegativePrompt = "explicit images"
    Size = "512x512"
    NumberImages = 1
    InferenceSteps = 8
    GuidanceScale = 1.0
    Seed = -1
} | ConvertTo-Json

Invoke-RestMethod -Uri "http://localhost:8000/v1/images/generations" -Method POST -ContentType "application/json" -Body $body